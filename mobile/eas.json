{
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "testing",
      "environment": "preview"
    },
    "production": {
      "channel": "production",
      "environment": "production"
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "android": {
        "buildType": "apk"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    }
  },
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  }
}
